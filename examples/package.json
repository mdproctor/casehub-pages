{
  "name": "@casehubio/pages-examples",
  "version": "0.0.0",
  "description": "CaseHub Pages Examples Gallery",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "generate-samples": "node scripts/generate-samples.js",
    "copy-samples": "node scripts/copy-samples.js",
    "build:bundle": "webpack --env prod",
    "build:bundle:dev": "webpack --env dev",
    "copy-fixtures": "node -e \"const fs=require('fs');const p=require('path');const src=p.join(__dirname,'fixtures');const dst=p.join(__dirname,'dist','fixtures');if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(p.join(src,f),p.join(dst,f)));}\"",
    "build": "yarn clean && yarn generate-samples && yarn build:bundle && yarn copy-samples && yarn copy-fixtures",
    "typecheck": "tsc --noEmit",
    "serve": "npx http-server dist -c-1 -p 8080 -o",
    "dev": "node scripts/dev-server.js",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed"
  },
  "dependencies": {
    "@casehubio/graph-core": "workspace:*",
    "@casehubio/graph-renderer": "workspace:*",
    "@casehubio/pages-aria": "workspace:*",
    "@casehubio/pages-code-editor": "workspace:*",
    "@casehubio/pages-data": "workspace:*",
    "@casehubio/pages-diagram-palette": "workspace:*",
    "@casehubio/pages-property-palette": "workspace:*",
    "@casehubio/pages-runtime": "workspace:*",
    "@casehubio/pages-ui": "workspace:*",
    "@casehubio/pages-ui-tokens": "workspace:*",
    "@casehubio/pages-viz": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@casehubio/pages-webpack-base": "workspace:*",
    "@playwright/test": "^1.50.0",
    "browser-sync": "^2.29.3",
    "chokidar": "^3.5.3",
    "http-server": "^14.1.1",
    "rimraf": "^6.1.0",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.6.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  },
  "keywords": [
    "casehub-pages",
    "samples",
    "examples"
  ],
  "license": "Apache-2.0"
}
