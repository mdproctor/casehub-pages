{
  "name": "@casehubio/pages-lsp",
  "version": "0.1.0",
  "description": "CaseHub LSP server — schema-driven completion, diagnostics, and hover for CaseHub Playbook YAML formats",
  "repository": {
    "type": "git",
    "url": "https://github.com/casehubio/casehub-pages.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "casehub-lsp": "./dist/server-node.bundle.cjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/server-node.js",
    "./browser": "./dist/server-browser.js",
    "./page-format": "./dist/page-format.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "node build-bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@casehubio/pages-schema": "workspace:*",
    "@casehubio/yaml-core": "workspace:*",
    "vscode-languageserver": "^10.0.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "yaml": "^2.7.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@casehubio/pages-tsconfig": "workspace:*",
    "esbuild": "^0.28.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.1"
  },
  "license": "Apache-2.0"
}
